# ==========================================
# LearnSmart Backend - Environment Variables
# ==========================================

# Server Port
PORT=5000

# ==========================================
# Real Email OTP Configuration (SMTP)
# ==========================================
# For Gmail:
# 1. Go to your Google Account -> Security
# 2. Turn on 2-Step Verification
# 3. Search for "App Passwords"
# 4. Create an App password (name it "LearnSmart")
# 5. Paste your Gmail address and the 16-character App Password below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LearnSmart Adaptive Quiz <adaptivequizofficial@gmail.com>"

# ==========================================
# Security & Rate Limiting Settings
# ==========================================
OTP_SECRET_SALT=learnsmart_adaptive_quiz_secret_salt_2026_xyz
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_HOURLY_RESENDS=5
